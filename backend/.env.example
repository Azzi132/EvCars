# Copy this file to `.env` and fill in your real values. Never commit `.env`.

# MongoDB connection string (e.g. from Atlas or a local mongod).
MONGODB_URI=your_mongodb_connection_string_here

# Secret used to sign JWTs. Use a long random string — anything signed
# with this can act as any user, so treat it like a password.
JWT_SECRET=your_random_secret_here

# Open Charge Map API key — used by /api/stations/nearby to look up
# real-world charging stations. Get one at openchargemap.org/site/develop/api.
OCM_API_KEY=your_open_charge_map_key_here
